# Runtime settings for the local Node.js service.
NODE_ENV=production
HOST=127.0.0.1
PORT=3000
VINEXT_TRUSTED_HOSTS=monkeyquest.fil.one

# S3 credentials are used only by the server-side URL signer.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Optional when using temporary AWS credentials.
AWS_SESSION_TOKEN=

# S3 location of the private MP4 trailer.
AWS_REGION=us-east-1
S3_ENDPOINT=https://us-east-1.s3.fil.one
S3_BUCKET=toei
S3_VIDEO_KEY=monkeyquest1080p.mp4

# Presigned URL lifetime in seconds. Values are clamped to 60–3600.
VIDEO_URL_TTL_SECONDS=900
